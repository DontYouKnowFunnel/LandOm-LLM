LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4-mini
LLM_BASE_URL=https://llm.example.com

OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

BACKEND_BASE_URL=https://backend.example.com

OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_FEATURE_MODEL=gpt-5.4-mini
OPENAI_RECOMMENDATION_MODEL=gpt-5.4-mini

# Leave QDRANT_URL empty to use local embedded Qdrant at QDRANT_PATH.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=run/qdrant
QDRANT_PROBLEM_COLLECTION=problem_patterns_en
QDRANT_REVISION_COLLECTION=intervention_evidence_en

PROBLEM_TOP_K=5
SELECTED_PROBLEM_TOP_K=3
PROBLEM_CANDIDATE_K=200
REVISION_TOP_K=5
REVISION_CANDIDATE_K=200
RECOMMENDATION_TOP_N=3
RECOMMENDATION_GENERATION_MODE=llm
